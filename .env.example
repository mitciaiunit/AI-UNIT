# ==============================================================================
# AI Unit Website - environment configuration
# ==============================================================================
# Copy this file to .env and fill in real values for your machine:
#
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed - only this .env.example is.
# It's loaded automatically on every request by bootstrap.php via
# vlucas/phpdotenv. Every value below also has a safe fallback baked into
# config/config.php and config/database.php, so the site still runs even
# without a .env file at all - but a real database connection needs the
# DATABASE_* values below to match your MySQL setup.

# ------------------------------------------------------------------------------
# Application (config/config.php)
# ------------------------------------------------------------------------------
APP_ENV=development

# Shows PHP errors in the browser. Defaults to FALSE in config/config.php when
# this key is absent, so a deployment cannot leak stack traces by forgetting
# it. Set it to true only on a development machine; never on the live site.
# Errors are written to storage/logs/php-error.log regardless of this setting.
APP_DEBUG=true

# The URL prefix of public/ - the base for routes, assets and uploads alike.
# Leave blank to auto-detect from the request, which works both when public/ is
# the DocumentRoot (prefix "") and when it is served under a path such as
# /AI-UNIT/public. Only set it if the site is reachable at a different URL than
# the one it auto-detects, e.g. behind a reverse proxy that rewrites the path.
#
# APP_ROOT_URL used to sit here as a second base for assets/, which lived
# outside public/. Assets are inside public/ now, so the two collapsed into
# this one variable; a stale APP_ROOT_URL in an existing .env is simply
# ignored.
APP_BASE_URL=

# ------------------------------------------------------------------------------
# Database (config/database.php) - values shown match a stock XAMPP/EasyPHP
# MySQL install (root user, no password, default port).
# ------------------------------------------------------------------------------
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# AI Lab booking (config/config.php -> ai_lab.calendly_url)
# ------------------------------------------------------------------------------
# The AI Unit's PUBLIC Calendly scheduling link for AI Lab sessions, e.g.
#   CALENDLY_AI_LAB_URL=https://calendly.com/ai-unit-mauritius/ai-lab-session
#
# Leave blank until the real link exists. While blank, the AI Lab page shows a
# clearly-marked "booking not yet available" notice instead of an embed, so
# nothing looks broken and no visitor is sent to a wrong calendar.
#
# Only https://calendly.com/... URLs are accepted; anything else is ignored and
# treated as unconfigured. Never put a Calendly API key or personal access
# token here - this value is rendered into the public page.
CALENDLY_AI_LAB_URL=

# ------------------------------------------------------------------------------
# Contact form notifications (App\Services\EmailService)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false

CONTACT_EMAIL=aiunit@govmu.org

MAIL_FROM_ADDRESS=no-reply@aiunit.govmu.org
MAIL_FROM_NAME="AI Unit"

# SMTP_HOST/USERNAME/PASSWORD are required only once EMAIL_ENABLED=true -
# your real mail provider's SMTP server and mailbox credentials.
#
# IMPORTANT: wrap any value that contains a space in double quotes, e.g.
# SMTP_PASSWORD="jqcx iptw vrki rylt" (example) for a Gmail App Password (which Google
# displays in 4 space-separated groups) - an unquoted value with a space is
# invalid .env syntax and fails to parse (see bootstrap.php's try/catch,
# which logs the parse error and falls back to defaults instead of crashing,
# but sending will silently stay off until the value is quoted correctly).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# ------------------------------------------------------------------------------
# Contact form spam guard (App\Services\SpamGuard) - all optional
# ------------------------------------------------------------------------------
CONTACT_MIN_SUBMIT_SECONDS=3
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=600

# ------------------------------------------------------------------------------
# Highlights admin (App\Services\AuthService / App\Services\ImageUploadService)
# ------------------------------------------------------------------------------
ADMIN_SESSION_IDLE_TIMEOUT=1800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
HIGHLIGHTS_MAX_UPLOAD_BYTES=5242880

# ------------------------------------------------------------------------------
# DIVA API integration - Cloudflare Worker proxy to the Anthropic API
# ------------------------------------------------------------------------------
# The endpoint DIVA posts conversations to. There is NO default: leave this
# blank and the assistant renders as "temporarily unavailable" - dimmed and
# disabled, sending nothing - instead of guessing an address.
#
# It used to default to http://127.0.0.1:8000/api/chat, which meant a
# deployment without a .env pointed every visitor's browser at port 8000 on
# their own machine. A local proxy address belongs here, in your own .env, and
# never in a default that ships to production.
#
# Anything that is not a valid http(s) URL is treated as blank and logged.
DIVA_API_URL=https://diva-proxy.ruben-ramdhony.workers.dev/proxy
